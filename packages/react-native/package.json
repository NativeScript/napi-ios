{
  "name": "@nativescript/react-native",
  "version": "0.0.1",
  "description": "React Native TurboModule for NativeScript Native API access",
  "keywords": [
    "NativeScript",
    "React Native",
    "TurboModule",
    "JSI",
    "iOS"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NativeScript/napi-ios",
    "directory": "packages/react-native"
  },
  "author": {
    "name": "NativeScript Team",
    "email": "oss@nativescript.org"
  },
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "types": "src/index.d.ts",
  "files": [
    "src",
    "types",
    "ios",
    "metadata",
    "native-api-jsi",
    "NativeScriptNativeApi.podspec",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.79"
  },
  "codegenConfig": {
    "name": "NativeScriptNativeApiSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "org.nativescript.nativeapi"
    },
    "ios": {
      "modulesProvider": {
        "NativeScriptNativeApi": "NativeScriptNativeApiModuleProvider"
      }
    }
  }
}
